---
import BaseLayout from '../layouts/BaseLayout.astro';
import MinisterNetwork from '../components/MinisterNetwork.svelte';

// Fetch stats from Django API (SSR)
const API_URL = import.meta.env.DATA_API_URL || 'http://api:8000/api/v2';

let stats = {
  total_donations: 0,
  total_value: '0',
  dual_influence_count: 0,
};

// Top recipients (MPs only)
let topRecipients: Array<{
  actor: { id: number; name: string; actor_type: string };
  total_received: string;
  donation_count: number;
  current_party: { name: string } | null;
}> = [];

// Top parties for bar chart
let topParties: Array<{ name: string; total: number; percentage: number }> = [];

// Top lobbying clients with their agencies
let topLobbyingClients: Array<{ name: string; agency_count: number; agencies: string[] }> = [];

// Department meetings with top attendees
let departmentMeetings: Array<{
  department_name: string;
  total_meetings: number;
  top_attendees: Array<{ name: string; meeting_count: number }>;
}> = [];

// Fetch all data in parallel
try {
  const [statsRes, recipientsRes, partyRes, lobbyingRes, meetingsRes] = await Promise.all([
    fetch(`${API_URL}/aggregates/stats/`),
    fetch(`${API_URL}/aggregates/top-recipients/?limit=100`), // Need more to find 10 persons after filtering out parties
    fetch(`${API_URL}/aggregates/party-donations/?limit=10`), // Get more parties to include Green and Reform
    fetch(`${API_URL}/aggregates/top-lobbying-clients/?limit=20`),
    fetch(`${API_URL}/aggregates/department-meetings/?limit=5&top_attendees=3`),
  ]);

  if (statsRes.ok) {
    stats = await statsRes.json();
  }

  if (recipientsRes.ok) {
    const data = await recipientsRes.json();
    // Filter to persons (MPs) only and take top 20
    topRecipients = data.results
      .filter((r: any) => r.actor.actor_type === 'person')
      .slice(0, 20);
  }

  if (partyRes.ok) {
    const data = await partyRes.json();
    if (data.results && data.results.length > 0) {
      const maxValue = parseFloat(data.results[0].total_received);

      // Clean up party names for display
      const cleanPartyName = (name: string) => {
        return name
          .replace('The Labour Party', 'Labour')
          .replace('Conservative and Unionist Party', 'Conservative')
          .replace('Scottish National Party (SNP)', 'SNP')
          .replace('UK Independence Party (UKIP)', 'UKIP')
          .replace('Co-operative Party', 'Co-operative')
          .replace('Green Party', 'Green')
          .replace(' Party', '');
      };

      topParties = data.results.slice(0, 8).map((r: any) => ({
        name: cleanPartyName(r.party.name),
        total: parseFloat(r.total_received),
        percentage: (parseFloat(r.total_received) / maxValue) * 100,
      }));
    }
  }

  if (lobbyingRes.ok) {
    const data = await lobbyingRes.json();
    // Filter out placeholder entries (names starting with "(" or containing "Pro-Bono")
    const realClients = data.results.filter((r: any) =>
      !r.actor.name.startsWith('(') &&
      !r.actor.name.includes('Pro-Bono') &&
      r.actor.classification !== 'Unknown'
    );
    if (realClients.length > 0) {
      topLobbyingClients = realClients.slice(0, 10).map((r: any) => ({
        name: r.actor.name,
        agency_count: r.agency_count,
        agencies: r.agencies || [],
      }));
    }
  }

  if (meetingsRes.ok) {
    const data = await meetingsRes.json();
    // Helper to shorten department names
    const shortenDeptName = (name: string) => {
      return name
        .replace('Department for ', '')
        .replace('Department of ', '')
        .replace('Home Office', 'Home Office')
        .replace('Cabinet Office', 'Cabinet Office')
        .replace('HM Treasury', 'Treasury')
        .replace('Foreign, Commonwealth & Development Office', 'FCDO')
        .replace('Foreign, Commonwealth and Development Office', 'FCDO')
        .replace(' and ', ' & ');
    };

    departmentMeetings = data.results.map((r: any) => ({
      department_name: shortenDeptName(r.department.name),
      total_meetings: r.total_meetings,
      top_attendees: r.top_attendees.map((a: any) => ({
        name: a.actor.name,
        meeting_count: a.meeting_count
      }))
    }));
  }
} catch (error) {
  console.error('Failed to fetch data:', error);
}

// Format currency
const formatCurrency = (value: string | number) => {
  const num = typeof value === 'string' ? parseFloat(value) : value;
  if (num >= 1_000_000_000) return `£${(num / 1_000_000_000).toFixed(1)}bn`;
  if (num >= 1_000_000) return `£${(num / 1_000_000).toFixed(1)}m`;
  if (num >= 1_000) return `£${(num / 1_000).toFixed(0)}k`;
  return `£${num.toLocaleString()}`;
};
---

<BaseLayout title="Mapping influence in British politics">
  <main class="min-h-screen">
    <!-- Top Metadata Bar -->
    <header class="max-w-[1400px] mx-auto px-6 pt-4 flex justify-between items-center border-b border-ink/5 pb-2">
      <span class="section-label">Investigation</span>
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-ink-muted">Date updated: January 2026</span>
    </header>

    <!-- Main Navigation -->
    <nav class="max-w-[1400px] mx-auto px-6 py-6 flex justify-between items-center">
      <div class="flex items-center gap-10">
        <a href="/" class="text-2xl font-bold tracking-tighter uppercase font-display">
          Under<span class="text-accent">The</span>Influence
        </a>
        <div class="hidden lg:flex gap-8 text-[11px] font-bold uppercase tracking-[0.15em]">
          <a href="/" class="text-accent">The Web</a>
          <a href="/directory" class="hover:text-accent transition-colors">Directory</a>
          <a href="/analysis" class="hover:text-accent transition-colors">Analysis</a>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="relative hidden md:block">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="text"
            placeholder="Search actors..."
            class="bg-ink/5 border-none rounded-none py-2 pl-10 pr-4 text-xs focus:ring-1 focus:ring-accent focus:outline-none w-48 transition-all"
          />
        </div>
        <button class="p-2 hover:bg-ink/5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Hero section -->
    <section class="max-w-[1400px] mx-auto px-6 pt-8 pb-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-8">
          <h1 class="text-6xl md:text-7xl font-bold tracking-tight leading-[0.95] mb-6 font-display">
            The web of money and<br />access in Westminster
          </h1>
          <p class="text-xl text-ink-light leading-relaxed max-w-2xl font-medium">
            Who funds British politics—and what do they get in return? This investigation
            maps the financial relationships between donors and government ministers.
          </p>
        </div>
      </div>
    </section>

    <!-- Stats as editorial typography -->
    <section class="max-w-[1400px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-y border-ink/10 py-10">
        <div class="flex flex-col items-center text-center px-8 md:border-r border-ink/10">
          <span class="stat-figure tabular">{stats.total_donations.toLocaleString()}</span>
          <span class="stat-label">Donations tracked</span>
        </div>
        <div class="flex flex-col items-center text-center px-8 md:border-r border-ink/10">
          <span class="stat-figure">{formatCurrency(stats.total_value)}</span>
          <span class="stat-label">Total value declared</span>
        </div>
        <div class="flex flex-col items-center text-center px-8">
          <span class="stat-figure tabular">{stats.dual_influence_count}</span>
          <span class="stat-label">Dual-influence relationships</span>
        </div>
      </div>
    </section>

    <!-- Full-width Network Visualization -->
    <section class="w-full py-12 mt-12 overflow-visible">
      <div class="max-w-[1400px] mx-auto px-6 mb-6">
        <div class="flex flex-col md:flex-row justify-between items-baseline gap-4">
          <div>
            <h3 class="text-2xl font-bold font-display">The Government Ministers Network</h3>
            <p class="text-xs text-ink-muted mt-1 italic">
              Financial connections between donors and government ministers. Node size reflects total donation value.
            </p>
          </div>
          <div class="flex gap-4 text-[10px] font-bold uppercase tracking-widest text-ink-muted">
            <span>Source: MPs' Register of Interests, Electoral Commission</span>
          </div>
        </div>
      </div>

      <!-- Full-width visualization container - overflow into margins for Victorian illustration feel -->
      <div class="w-full bg-paper overflow-visible -mx-8 px-8" style="margin-top: -2rem; margin-bottom: -4rem;">
        <MinisterNetwork
          client:visible
          apiUrl="http://localhost:8000/api/v2/aggregates/minister-network/"
          width={1400}
          height={800}
          currentOnly={true}
          minValue={5000}
          minMeetings={5}
        />
      </div>
    </section>

    <!-- Top Recipients + Deep Dive Section -->
    <section class="max-w-[1400px] mx-auto px-6 mt-24">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Top Recipients Column -->
        <div class="space-y-4">
          <p class="section-label border-b border-accent pb-2">Top Recipients</p>

          {topRecipients.length > 0 ? (
            <ol class="space-y-3">
              {topRecipients.map((recipient, index) => (
                <li class="group">
                  <a href={`/person/${recipient.actor.id}`} class="flex items-baseline gap-3">
                    <span class="text-[10px] font-bold text-ink-muted w-4">{index + 1}.</span>
                    <div class="flex-1 min-w-0">
                      <div class="flex justify-between items-baseline gap-2">
                        <div class="truncate">
                          <span class="font-display font-semibold group-hover:text-accent transition-colors">
                            {recipient.actor.name}
                          </span>
                          {recipient.current_party && (
                            <span class="text-[10px] text-ink-muted ml-1">
                              ({recipient.current_party.name})
                            </span>
                          )}
                        </div>
                        <span class="font-display font-bold text-lg tabular shrink-0">
                          {formatCurrency(recipient.total_received)}
                        </span>
                      </div>
                      <p class="text-[10px] text-ink-muted">
                        {recipient.donation_count} donations
                      </p>
                    </div>
                  </a>
                  {index < topRecipients.length - 1 && (
                    <div class="h-px bg-ink/5 w-full mt-3"></div>
                  )}
                </li>
              ))}
            </ol>
          ) : (
            <p class="text-sm text-ink-muted italic">Loading recipients...</p>
          )}
        </div>

        <!-- Deep Dive Column (spans 2 columns) -->
        <div class="md:col-span-2 space-y-8">
          <p class="section-label border-b border-accent pb-2">Deep Dive</p>

          <!-- Party Funding Card - Full Width -->
          <a href="/parties" class="group block">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              <div class="space-y-3">
                <p class="text-[10px] font-bold uppercase tracking-widest text-accent">Party Funding</p>
                <h4 class="text-2xl font-bold font-display group-hover:text-accent transition-colors">
                  Follow the money by party
                </h4>
                <p class="text-sm text-ink-light leading-relaxed italic">
                  "The Conservative Party has received more than double the funding of Labour since 2010."
                </p>
                <span class="text-[10px] font-bold uppercase tracking-widest text-accent flex items-center gap-1 pt-2">
                  Explore party funding
                  <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
              <div class="bg-ink/[0.02] p-5 border border-ink/5">
                <h5 class="text-[10px] font-bold uppercase tracking-widest mb-4">Donations by Party</h5>
                <div class="space-y-3">
                  {topParties.map((party) => (
                    <div>
                      <div class="flex justify-between text-[10px] font-bold uppercase mb-1">
                        <span>{party.name}</span>
                        <span>{formatCurrency(party.total)}</span>
                      </div>
                      <div class="h-1.5 bg-ink/5">
                        <div class="h-full bg-accent" style={`width: ${party.percentage}%`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="h-px bg-ink/10 w-full mt-8"></div>
          </a>

          <!-- Ministerial Access Card - Full Width -->
          <a href="/meetings" class="group block">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              <div class="space-y-3">
                <p class="text-[10px] font-bold uppercase tracking-widest text-accent">Ministerial Access</p>
                <h4 class="text-2xl font-bold font-display group-hover:text-accent transition-colors">
                  Who gets in the room?
                </h4>
                <p class="text-sm text-ink-light leading-relaxed italic">
                  "Thousands of meetings between ministers and external organisations are disclosed quarterly."
                </p>
                <span class="text-[10px] font-bold uppercase tracking-widest text-accent flex items-center gap-1 pt-2">
                  Explore meetings
                  <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
              <!-- Departments by meeting count with top attendees -->
              <div class="bg-ink/[0.02] p-5 border border-ink/5">
                <h5 class="text-[10px] font-bold uppercase tracking-widest mb-4">Meetings by Department</h5>
                <div class="space-y-4">
                  {departmentMeetings.map((dept) => (
                    <div>
                      <div class="flex justify-between items-baseline mb-1.5">
                        <span class="text-[11px] font-bold truncate" title={dept.department_name}>{dept.department_name}</span>
                        <span class="text-sm font-display font-bold ml-2 shrink-0 tabular">{dept.total_meetings.toLocaleString()}</span>
                      </div>
                      <div class="space-y-0.5 pl-2 border-l-2 border-accent/20">
                        {dept.top_attendees.map((attendee) => (
                          <div class="flex justify-between items-baseline text-[9px] text-ink-muted">
                            <span class="truncate" title={attendee.name}>{attendee.name}</span>
                            <span class="ml-2 shrink-0 tabular">{attendee.meeting_count}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="h-px bg-ink/10 w-full mt-8"></div>
          </a>

          <!-- Lobbying Influence Card - Full Width -->
          <a href="/lobbying" class="group block">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              <div class="space-y-3">
                <p class="text-[10px] font-bold uppercase tracking-widest text-accent">Lobbying Influence</p>
                <h4 class="text-2xl font-bold font-display group-hover:text-accent transition-colors">
                  Who hires the lobbyists?
                </h4>
                <p class="text-sm text-ink-light leading-relaxed italic">
                  "Major corporations employ multiple lobbying agencies to access government."
                </p>
                <span class="text-[10px] font-bold uppercase tracking-widest text-accent flex items-center gap-1 pt-2">
                  Explore lobbying
                  <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
              <!-- Organizations with their agencies -->
              <div class="bg-ink/[0.02] p-5 border border-ink/5">
                <h5 class="text-[10px] font-bold uppercase tracking-widest mb-4">Top Clients & Their Agencies</h5>
                <div class="space-y-4">
                  {topLobbyingClients.slice(0, 5).map((client) => (
                    <div>
                      <div class="flex justify-between items-baseline mb-1">
                        <span class="text-[11px] font-bold truncate" title={client.name}>{client.name}</span>
                        <span class="text-[10px] text-ink-muted ml-2 shrink-0">{client.agency_count} agencies</span>
                      </div>
                      <div class="text-[9px] text-ink-muted leading-relaxed pl-2 border-l-2 border-accent/20">
                        {client.agencies.join(' · ')}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Methodology -->
    <section class="max-w-[1400px] mx-auto px-6 mt-32 pt-12 border-t-2 border-ink">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
        <div>
          <h5 class="text-[11px] font-bold uppercase tracking-[0.2em] mb-4">Methodology</h5>
        </div>
        <div class="md:col-span-3">
          <p class="text-sm text-ink-muted leading-relaxed mb-6">
            This visualisation shows donations to individuals who have held ministerial
            office in UK government. Donation data is sourced from the MPs' Register of Interests
            and the Electoral Commission's database of political donations. Node positions
            are calculated using a force-directed layout algorithm mimicking the specimen
            plates of Victorian naturalists.
          </p>
          <p class="text-[10px] font-bold uppercase tracking-widest text-ink-muted">
            Under the Influence is an ongoing investigation into political funding in the UK.
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="max-w-[1400px] mx-auto px-6 mt-20 pb-12 flex flex-col sm:flex-row justify-between items-center gap-4 text-[9px] font-bold uppercase tracking-[0.3em] text-ink-muted">
      <span>© 2026 UnderTheInfluence</span>
      <div class="flex gap-8">
        <a href="/privacy" class="hover:text-ink transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-ink transition-colors">Terms of Use</a>
        <a href="/data" class="hover:text-ink transition-colors">Data Access</a>
      </div>
    </footer>
  </main>
</BaseLayout>
