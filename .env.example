# Django Settings
# ===============

# Environment: '1' for development/staging, '0' for production
STAGING=1

# SECURITY WARNING: Generate a new secret key for production!
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=change-me-in-production-generate-a-random-secret-key

# Debug mode (will be automatically set based on STAGING)
DEBUG=True

# Allowed hosts (comma-separated list)
# For development: localhost,127.0.0.1
# For production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base URL for the site
BASE_URL=http://localhost:8000


# Database Configuration
# ======================

# Database system: 'postgresql' or 'sqlite'
DATABASE_SYSTEM=postgresql

# PostgreSQL settings (used when DATABASE_SYSTEM=postgresql)
UTI_DB_NAME=undertheinfluence
UTI_DB_USER=uti
UTI_DB_PASS=changeme
UTI_DB_HOST=db
UTI_DB_PORT=5432


# Redis Configuration
# ===================

REDIS_URL=redis://redis:6379/0


# Email Configuration
# ===================

# Support email displayed on the site
SUPPORT_EMAIL=support@example.com

# From address for error emails
SERVER_EMAIL=server@example.com

# From address for all other emails
DEFAULT_FROM_EMAIL=noreply@example.com

# Admin email addresses (comma-separated: "Name <email>, Name <email>")
ADMINS=


# External API Keys
# =================

# TheyWorkForYou API key (optional)
TWFY_API_KEY=

# Companies House API key (for organization enrichment)
# Get one at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=


# Elasticsearch Configuration (optional)
# =======================================

# Elasticsearch URL (uncomment if using Elasticsearch)
# ELASTICSEARCH_URL=http://elasticsearch:9200
